        "options": {},
        "content": "=🟢 **Routine email answered** ({{ $('Parse & Route').item.json.autoSend ? 'sent' : 'draft saved, review in Gmail' }})\n**To:** {{ $('Parse & Route').item.json.from }} — {{ $('Parse & Route').item.json.subject }}\n**Reply:** {{ $('Parse & Route').item.json.reply.slice(0, 600) }}"
      },
      "name": "Discord: Reply Note",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1180,
        60
      ],
      "credentials": {
        "discordOAuth2Api": {
          "id": "",
          "name": "Discord Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Keep newsletter summaries until the next digest (workflow static data; persists in production runs).\nconst sd = $getWorkflowStaticData('global');\nsd.newsletters = sd.newsletters || [];\nfor (const it of $input.all()) sd.newsletters.push({ from: it.json.fromName || it.json.from, subject: it.json.subject, summary: it.json.summary, at: new Date().toISOString() });\nsd.newsletters = sd.newsletters.slice(-200);\nreturn [{ json: { queued: $input.all().length, total: sd.newsletters.length } }];"
      },
      "name": "Queue Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7,19 * * *"
            }
          ]
        }
      },
      "name": "Twice a Day (07:30, 19:30)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        420,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the twice-daily newsletter digest and clear the queue.\nconst sd = $getWorkflowStaticData('global');\nconst items = sd.newsletters || [];\nif (!items.length) return [];\nsd.newsletters = [];\nconst lines = items.slice(0, 40).map(n => `• **${n.from}** — ${n.subject}\\n  ${n.summary}`);\nlet content = `📰 **Newsletter digest** (${items.length})\\n` + lines.join('\\n');\nif (content.length > 1950) content = content.slice(0, 1940) + '\\n…';\nreturn [{ json: { content } }];"
      },
      "name": "Build Newsletter Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        460
      ]
    },
