    {
      "parameters": {
        "jsCode": "return [\n { json: { id: 'demo1', threadId: 'demo1', from: { value: [{ address: 'client@example.com', name: 'Client' }] }, subject: 'Production site is down', text: 'Our checkout returns 500 since 9:00. Can you look at it today?' } },\n { json: { id: 'demo2', threadId: 'demo2', from: { value: [{ address: 'partner@example.com', name: 'Partner' }] }, subject: 'Partnership idea for Q1', text: 'Would you be open to a call next week about a joint offer?' } },\n { json: { id: 'demo3', threadId: 'demo3', from: { value: [{ address: 'friend@example.com', name: 'Friend' }] }, subject: 'Thanks!', text: 'Thanks for the tips yesterday, very helpful.' } },\n { json: { id: 'demo4', threadId: 'demo4', from: { value: [{ address: 'news@example.com', name: 'Weekly Dev News' }] }, subject: 'This week in AI', text: 'Top stories... unsubscribe here.' } },\n];"
      },
      "name": "Sample Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Edit these values once after import. Emails pass through unchanged; settings are attached as `cfg`.\nconst cfg = {\n  ownerName: 'Kacper',                       // who the assistant works for\n  assistantName: 'Baizhi',                   // signature of AI replies\n  autoSend: false,                           // false = routine replies are saved as Gmail drafts (recommended)\n  ignoreSenders: ['no-reply@accounts.google.com'], // never auto-answer these\n};\nreturn $input.all().map(i => ({ json: { ...i.json, cfg } }));"
      },
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise Gmail output (simple or raw mode) into one shape and build the classifier request.\nconst cfg = $('Config').first().json.cfg;\nconst out = [];\nfor (const it of $input.all()) {\n  const m = it.json;\n  const fromObj = m.from?.value?.[0] || {};\n  const from = fromObj.address || (String(m.From || m.from || '').match(/<([^>]+)>/) || [])[1] || String(m.From || m.from || '');\n  const fromName = fromObj.name || String(m.From || '').replace(/<[^>]+>/, '').trim();\n  const subject = String(m.subject || m.Subject || '(no subject)');\n  const body = String(m.text || m.textPlain || m.snippet || '').replace(/\\s+/g, ' ').trim().slice(0, 4000);\n  const listUnsub = !!(m.headers && (m.headers['list-unsubscribe'] || m.headers['List-Unsubscribe'])) || /unsubscribe/i.test(body);\n  const prompt = `You triage the inbox of ${cfg.ownerName}. Classify the email into exactly one category:\n- \"urgent\": important AND time-critical (client problem, payment issue, security alert, deadline today/tomorrow). ${cfg.ownerName} must handle it personally now.\n- \"important\": matters but is not urgent (proposal, meeting request, partnership, invoice to plan). ${cfg.ownerName} will schedule it.\n- \"routine\": low-stakes personal or business message a polite assistant can answer (thanks, confirmations, simple questions).\n- \"newsletter\": newsletters, promotions, notifications, subscriptions, automated mail.\nReturn JSON only: {\"category\": \"...\", \"summary\": \"max 2 sentences\", \"reply\": \"a short friendly reply for routine mail signed '${cfg.assistantName}, assistant to ${cfg.ownerName}', otherwise empty\", \"confidence\": 0.0-1.0}\nNever promise dates, prices or commitments in the reply.\n\nFrom: ${fromName} <${from}>\nSubject: ${subject}\nHas unsubscribe link: ${listUnsub}\nBody:\n${body}`;\n  out.push({ json: { id: m.id, threadId: m.threadId, from, fromName, subject, body, listUnsub,\n    requestBody: { contents: [{ parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, responseMimeType: 'application/json' } } } });\n}\nreturn out;"
      },
      "name": "Normalize & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Gemini Classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        0
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Gemini API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Parse the classifier answer; fall back to safe defaults on bad output.\nconst cfg = $('Config').first().json.cfg;\nconst src = $('Normalize & Build Prompt').all();\nreturn $input.all().map((it, i) => {\n  const mail = src[i]?.json || {};\n  let r = {};\n  try { r = JSON.parse(it.json.candidates?.[0]?.content?.parts?.[0]?.text || '{}'); } catch (e) { r = {}; }\n  let category = ['urgent', 'important', 'routine', 'newsletter'].includes(r.category) ? r.category : 'important'; // unknown -> a human looks at it\n  if (category === 'routine' && (cfg.ignoreSenders || []).some(s => mail.from?.toLowerCase().includes(s))) category = 'newsletter';\n  if (category === 'routine' && !String(r.reply || '').trim()) category = 'important';\n  return { json: { ...mail, category, summary: String(r.summary || mail.body?.slice(0, 200) || ''), reply: String(r.reply || ''),\n    confidence: Number(r.confidence) || 0, autoSend: !!cfg.autoSend, gmailLink: 'https://mail.google.com/mail/u/0/#all/' + (mail.threadId || mail.id || '') } };\n});"
      },
      "name": "Parse & Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "urgent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "urgent"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "important",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "important"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "routine",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "routine"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "newsletter",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "newsletter"
            }
          ]
        },
        "options": {}
      },
      "name": "Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        420,
